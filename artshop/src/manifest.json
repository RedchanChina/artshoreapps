{
    "name": "ArtShop",
    "appid": "",
    "description": "让生活多一点艺术 / More Art In Life",
    "versionName": "1.0.0",
    "versionCode": "100",
    "transformPx": true,
    "h5": {
        "title": "ArtShop — More Art In Life",
        "template": "index.html",
        "router": {
            "mode": "hash",
            "base": "/"
        },
        "sdkConfigs": {},
        "async": {
            "loading": "AsyncLoading"
        },
        "devServer": {
            "host": "0.0.0.0",
            "port": 5173,
            "https": false
        },
        "publicPath": "/",
        "viewport": {
            "responsive": true,
            "deviceRatio": {}
        },
        "flexible": true,
        "resetViewport": false
    },
    "app-plus": {
        "usingComponents": true,
        "nvueStyleCompiler": "uni-app",
        "compilerVersion": 3,
        "splashscreen": {
            "alwaysShowBeforeRender": true,
            "waiting": true,
            "autoclose": true,
            "delay": 0
        },
        "modules": {
            "Camera": {},
            "Maps": {}
        },
        "distribute": {
            "android": {
                "permissions": [
                    "<uses-permission android:name=\"android.permission.CHANGE_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.CAMERA\"/>",
                    "<uses-feature android:name=\"android.hardware.camera\"/>",
                    "<uses-feature android:name=\"android.hardware.camera.autofocus\"/>"
                ]
            },
            "ios": {},
            "sdkConfigs": {
                "maps": {},
                "payment": {
                    "weixin": {
                        "appid": "",
                        "UniversalLinks": ""
                    },
                    "alipay": {}
                }
            }
        }
    },
    "quickapp": {},
    "mp-weixin": {
        "appid": "",
        "setting": {
            "urlCheck": false
        },
        "usingComponents": true
    },
    "mp-alipay": {
        "usingComponents": true
    },
    "mp-baidu": {
        "usingComponents": true
    },
    "mp-toutiao": {
        "usingComponents": true
    },
    "uniStatistics": {
        "enable": false
    },
    "vueVersion": "3"
}
